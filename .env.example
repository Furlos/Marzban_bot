# Copy to .env and insert credentials; NEVER commit real credentials.
# URL of the Marzban server (scheme + host); a trailing /api is also accepted.
MARZBAN_API_URL=https://marzban.example.com
API_TOKEN=REPLACE_WITH_MARZBAN_ADMIN_TOKEN
BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
# Generate a strong random token (e.g. python -c "import secrets; print(secrets.token_urlsafe(32))").
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
